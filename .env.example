# Panel del proyecto Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave "service_role" — NUNCA exponerla al cliente ni commitear el valor real.
# Se usa solo en Server Actions ya protegidas por rol Admin (ver lib/supabase/server.ts).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# API Google Calendar — panel de Google Cloud Console → APIs & Services → Credentials.
# NUNCA commitear el valor real (ver nota de SUPABASE_SERVICE_ROLE_KEY arriba).
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
